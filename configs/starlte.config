# HakiOS fragment: the Samsung Galaxy S9 (starlte, devices/starlte) -- what is true of this phone and of no other with the same SoC.
# The drivers below are built in. The ones seen working on the phone are started by default: their arguments are set at the end
# of this file ("The S9's defaults"), and devices/starlte/mkimage.sh puts them on every image's command line, under whatever a
# run gives itself (name=value replaces a default, name= takes it out; tools/hakios-config.py args --with). A driver not yet
# seen working stays off until its argument is given, one step a flash (README.md, "First runs of the drivers").
# Every driver of the common repository is another phone's (Qualcomm's blocks at Qualcomm's addresses) or a virtual machine's: all
# are left out, and with them the arguments only they read. Firmware: the Wi-Fi's (BCM4361) is the phone's own, from its
# VENDOR partition at run time or firmware/wifi (WIFI.md); nothing else of the phone's is loaded.
CONFIG_DEVICE="starlte"
CONFIG_FIRMWARE="device"
# The keys: power is the side button, volume, Bixby the home button (drivers/input/hakios.exynos_keys.c)
CONFIG_HAKIOS_EXYNOS_KEYS=y
# CONFIG_EXYNOS_KEYS is not set
# The touch screen: the S6SY761 on USI03's I2C (drivers/input/hakios.s6sy761.c)
CONFIG_HAKIOS_S6SY761=y
# CONFIG_S6SY761 is not set
# The I2C both of those and the battery use (drivers/core/hakios.exynos_hsi2c.c)
CONFIG_HAKIOS_EXYNOS_HSI2C=y
# The battery: the MAX77705's gauge and charger, read only, into HakiosBattery, iOS's power source
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_MAX77705=y
# CONFIG_MAX77705 is not set
# The panel's brightness (AOR through DSIM0): kern.hakios.brightness
CONFIG_HAKIOS_S6E3HA8=y
# CONFIG_PANEL is not set
# The storage: the kernel's own UFS driver after a self-test against the loader's reads (ufs=3, a default below), the
# loader's block service through Silicium's UEFI (ufs=2) its fallback; the loader keeps core 0 to serve it (README.md, "Storage")
CONFIG_HAKIOS_UFS=y
# The GPU, a Mali-G72 MP18 (drivers/gpu/hakios.mali.c): brought up by mali=N, the first N of its nine steps (1 only
# looks, 9 is everything and HakiosMali for programs; mali=9 a default below)
CONFIG_HAKIOS_MALI=y
# ... and ACPM, through which it holds its supply on and has its clock set (drivers/core/hakios.exynos_acpm.c)
CONFIG_HAKIOS_EXYNOS_ACPM=y
# The big cores' preparation before CPU_ON: the six CLUSTER1 fields of the PMU Samsung's kernel writes first (drivers/core/
# hakios.exynos_m3.c): m3_prep=3, a default below, brings up the four M3s (README.md, "The cores")
CONFIG_HAKIOS_EXYNOS_M3=y
# The clock: the S2MPS18's RTC read through ACPM at start-up, read only (drivers/power/hakios.s2mps18_rtc.c): rtc_pmic=1, a
# default below (README.md, "The clock")
CONFIG_HAKIOS_S2MPS18_RTC=y
# The CPU frequency governor: both clusters' rates moved with the load, the touch screen and the heat, within Samsung's limits
# (drivers/power/hakios.exynos_cpufreq.c): cpufreq_gov=1, a default below (README.md, "CPU clocks")
CONFIG_HAKIOS_EXYNOS_CPUFREQ=y
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# The flashlight: the S2MPB02's flash block (drivers/camera/hakios.s2mpb02_torch.c), torch=3: for iOS
CONFIG_HAKIOS_S2MPB02_TORCH=y
# The front camera (drivers/camera/hakios.exynos_camera.c, CAMERA.md): cam_s9=1..7, 7 streaming for the Camera app (with cam=5)
CONFIG_HAKIOS_EXYNOS_CAMERA=y
# The hardware video decoder (common repository, drivers/gpu/hakios.exynos_mfc.c): mfc=1..5, 5 a default below (mfc_zc is not: its one run had wrong frames)
CONFIG_HAKIOS_EXYNOS_MFC=y
# The iris camera, the S5K5F1 infrared sensor on CSIS3, and its IR LED (drivers/camera/hakios.exynos_iris.c, CAMERA.md "The
# iris camera"): iris_s9=1..5, the sensor answers only with iris_s9_smc=1 and no frame reaches memory yet; off unless asked, and only in a run without cam_s9= and torch=
CONFIG_HAKIOS_EXYNOS_IRIS=y
# The secure OS asked and at most started (drivers/core/hakios.exynos_tee.c): tee_probe=1 reads, tee_probe=2 starts it, nothing more; off unless asked, in no default line
CONFIG_HAKIOS_EXYNOS_TEE=y
# The speakers' two MAX98512 amplifiers (drivers/audio/hakios.max98512.c): max98512=N (1 a look, 2 set up and muted, 3 handed
# to ABOX's UAIF1, whose start and stop turn them on and off; 3 a default below)
CONFIG_HAKIOS_MAX98512=y
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# The speakers, the SoC's side: ABOX with its CPU off, RDMA0 -> UAIF1 (drivers/audio/hakios.exynos_abox.c), and the speakers'
# guard every sample goes through (hakios.guard.c). abox=N makes its first N steps (1 looks, 7 plays a tone, 8 serves iOS;
# 8 a default below). The MAX98512 amplifiers are another driver's.
CONFIG_HAKIOS_GUARD=y
CONFIG_HAKIOS_EXYNOS_ABOX=y
# The audio codec, a Cirrus CS47L93 on PERIC0's SPI (drivers/audio/hakios.cs47l93.c, drivers/core/hakios.exynos_spi.c):
# cs47l93=N (2 powers it and reads its ID, 6 makes the main microphone ready for ABOX's "abox rec"; 6 a default below).
# AUDIO.md, "The codec".
CONFIG_HAKIOS_EXYNOS_SPI=y
CONFIG_HAKIOS_CS47L93=y
# CONFIG_ABOX is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_WIFI is not set
# Wi-Fi, stage 1 (drivers/wifi/hakios.exynos_pcie.c): PCIe channel 0 to the BCM4361, WLAN_REG_ON, the link, the chip's ID and BARs.
# Started by wifi_pcie=N (1 only looks, 5 is all of stage 1, 6 hands the device on; 6 a default below). No firmware.
# CONFIG_WIFI_PCIE is not set
CONFIG_HAKIOS_EXYNOS_PCIE=y
# Wi-Fi, stage 2 (drivers/wifi/hakios.brcmfmac.c, WIFI.md): Linux's brcmfmac on the BCM4361 (tools/mk-brcmfmac.sh makes its
# object; a kernel built without it says so), with the station layer above (WIFI_STA). Started by wifi_pcie=6 brcmfmac=N
# (1 the chip's ID, 2 the files, 3 the firmware up, 4 its interface, 5 INTx, 6 the phone's address, 7 the station, 8 joining;
# 8 a default below, iOS's Settings choosing the network). The firmware, NVRAM and CLM are the phone's own: firmware/wifi
# in the image, or its VENDOR partition at run time (WIFI.md).
# CONFIG_BRCMFMAC is not set
CONFIG_HAKIOS_BRCMFMAC=y
CONFIG_HAKIOS_WIFI_STA=y
# CONFIG_HAKIOS_BT is not set
# Bluetooth (drivers/bluetooth/hakios.bcm4361_bt.c, BLUETOOTH.md): the BCM4361's Bluetooth half on UART_BT, BT_EN on the
# PCAL6524 expander, HCI over H4, Broadcom's patch, 4 Mbaud. Built in, started by bt=N (1 only looks, 2 the expander, 3 the
# UART in loopback, 4 the chip powered, 5 HCI_Reset and its version, 6 the patch, 7 the rate raised and the chip kept for
# Step 6 needs the phone's own bcm4361B2 .hcd (its VENDOR with ufs=2, or fw-bt/).
# No host stack in the kernel.
CONFIG_BT=7
CONFIG_HAKIOS_BCM4361_BT=y
# The sensors (drivers/input/hakios.ssp.c, SENSORS.md): the sensor hub in the BCM4775 GNSS chip on USI_CHUB00's SPI (the
# same SPI master as the codec's), its firmware (firmware/sensorhub/) loaded through the chip's ROM, Samsung's sensor
# protocol, the samples in /dev/hakios-sensors. Built in, started by shub=N (1 looks, 2 powered, 3 the ROM, 4 the
# firmware, 5 SSP, 6 the sensors on). A default.
CONFIG_HAKIOS_SSP=y
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# The USB port as a link to a host: the kernel's log streamed over a CDC-ACM serial port and a line console back
# (drivers/core/hakios.dwc3.c, device-neutral, and hakios.exynos_usb.c, the Exynos 9810's PHY and clocks): usb_gadget=N
# (1 looks, 2 the PHY, 3 the core, 4 enumerates, 5 streams the log; 5 a default below)
CONFIG_HAKIOS_USB_GADGET=y
CONFIG_HAKIOS_EXYNOS_USB=y

# ---- The S9's defaults: the configuration seen working on the phone (README.md, "Defaults") -----------------------------------
# Every image carries these unless a run says otherwise. Diagnostics (fps_log, systrace, *_probe, *_log, *_trace) are never
# defaults: give them for a run. What only the kernel reads is built into it (CONFIG_BUILTIN_ARGS), so the line holds what the
# loader and user space read; a run adds about 155 of its own (the loader's debug=, rd=, ufs_shared_pa= and hakios_kver=, mkimage.sh's
# loader_return_after= and epoch=). A built-in argument given for a run goes over its value; to turn one off, give it as 0.
CONFIG_BUILTIN_ARGS=y
CONFIG_CMDLINE_RUN=170
# All eight cores: the kernel starts on A55 2, core 1 by CPU_ON, core 0 from the loader after ufs=3's switch; on this SoC the
# loader takes cpus=8 for core0=1 core1=1 (README.md, "The cores")
CONFIG_CPUS=8
CONFIG_BOOTCPU=2
CONFIG_M3_PREP=3
CONFIG_PAN=0
CONFIG_ISA_FLOOR=1
# Keys, battery and charger, panel, touch, the USB-C switch to the SoC and the USB log and console
CONFIG_EXYNOS_KEYS=1
CONFIG_MAX77705=1
CONFIG_PANEL=1
CONFIG_S6SY761=1
CONFIG_MAX77705_USBSW=1
CONFIG_USB_GADGET=5
# The clusters' clocks moved with the load, the GPU (HakiosMali, mali=9) and its clock after its load
CONFIG_CPUFREQ_GOV=1
CONFIG_MALI=9
CONFIG_MALI_GOV=1
# The vibration motor, the thermal stop, the whole log kept for TWRP's /proc/last_kmsg
CONFIG_MAX77705_HAPTIC=1
CONFIG_TMU=3
CONFIG_ESSLOG=1
# SpringBoard's poster retried; iOS's brightness slider to the panel (backlight=2 takes what iOS sets, brightness_bridge in user space)
CONFIG_POSTER_RETRY=2
CONFIG_BACKLIGHT=2
CONFIG_BRIGHTNESS_BRIDGE=1
# The storage: the kernel's own UFS driver (ufs=3), iOS's system from SYSTEM, writes fenced to USERDATA, /private/var kept there
CONFIG_UFS=3
CONFIG_SYSTEM_APFS="ufs_SYSTEM"
CONFIG_UFS_WRITE=y
CONFIG_VAR_HFS="ufs_USERDATA_data"
# The display: scaled by the DPP, the window server's surface scanned out with nothing copied
CONFIG_FB_DPP=1
CONFIG_FB_ZC=1
# The time of day from the S2MPS18's RTC, read only
# CONFIG_RTC_PMIC is not set: every installer and daily has run without it (rtc_pmic=), and the line is full
# The front camera streaming into the stock Camera app
CONFIG_CAM_S9=7
CONFIG_CAM=5
# The speakers: ABOX serving iOS, the two MAX98512s; the codec (CS47L93) with its main microphone ready for "abox rec"
CONFIG_ABOX=8
CONFIG_MAX98512=3
CONFIG_CS47L93=6
# The hardware video decoder for VideoToolbox, on its interrupt: Safari's video seen smooth on the phone, 4 November
CONFIG_MFC=5
CONFIG_MFC_IRQ=1
# Wi-Fi: PCIe, brcmfmac joining, the station for iOS (Settings' join, DHCP)
CONFIG_WIFI_PCIE=6
CONFIG_BRCMFMAC=8
CONFIG_BRCMFMAC_POLL=1
CONFIG_BRCMFMAC_TCM_IDX=1
CONFIG_WIFI=y
# The microphone (hakios.exynos_abox.c, WDMA1) and the sensor hub, on by default.
CONFIG_ABOX_MIC=1
CONFIG_SHUB=6
