# HakiOS fragment: the Samsung Galaxy S9 (starlte, devices/starlte) -- what is true of this phone and of no other with the same SoC.
# The drivers below are built in but not started on the default command line: none has run on the phone yet. Each is brought up
# by its boot-argument, one step a flash (README.md, "First runs of the drivers"); a symbol goes back to =1 once its driver is seen working.
# Every driver of the common repository is another phone's (Qualcomm's blocks at Qualcomm's addresses) or a virtual machine's: all
# are left out, and with them the arguments only they read. No firmware is pulled from the phone.
CONFIG_DEVICE="starlte"
CONFIG_FIRMWARE="none"
# The keys: power is the side button, volume, Bixby the home button (drivers/input/hakios.exynos_keys.c)
CONFIG_HAKIOS_EXYNOS_KEYS=y
# CONFIG_EXYNOS_KEYS is not set
# The touch screen: the S6SY761 on USI03's I2C (drivers/input/hakios.s6sy761.c)
CONFIG_HAKIOS_S6SY761=y
# CONFIG_S6SY761 is not set
# The I2C both of those and the battery use (drivers/core/hakios.exynos_hsi2c.c)
CONFIG_HAKIOS_EXYNOS_HSI2C=y
# The battery: the MAX77705's gauge and charger, read only, into HakiosBattery, iOS's power source
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_MAX77705=y
# CONFIG_MAX77705 is not set
# The panel's brightness (AOR through DSIM0): kern.hakios.brightness
CONFIG_HAKIOS_S6E3HA8=y
# CONFIG_PANEL is not set
# The storage through the loader (Silicium's UEFI drives the UFS): built in, started by ufs=2 with bootcpu=4 cpus=8, which leaves
# core 0 to the loader to serve it (README.md, "Storage"). Not on the command line by default: the first boot needs none.
# CONFIG_UFS is not set
CONFIG_HAKIOS_UFS=y
# The GPU, a Mali-G72 MP18 (drivers/gpu/hakios.mali.c): built in, brought up by mali=N, the first N of its nine steps (1 only
# looks, 9 is everything and HakiosMali for programs). Not on the command line by default: the first boot runs without it.
# CONFIG_MALI is not set
CONFIG_HAKIOS_MALI=y
# ... and ACPM, through which it holds its supply on and has its clock set (drivers/core/hakios.exynos_acpm.c)
CONFIG_HAKIOS_EXYNOS_ACPM=y
# The big cores' preparation before CPU_ON: the six CLUSTER1 fields of the PMU Samsung's kernel writes first (drivers/core/
# hakios.exynos_m3.c). Built in, does nothing until m3_prep=N (README.md, "The cores"); written, not yet seen
CONFIG_HAKIOS_EXYNOS_M3=y
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# The flashlight: the S2MPB02's flash block (drivers/camera/hakios.s2mpb02_torch.c), torch=3: for iOS
CONFIG_HAKIOS_S2MPB02_TORCH=y
# The speakers' two MAX98512 amplifiers (drivers/audio/hakios.max98512.c): built in, off until max98512=N (1 a look, 2 set
# up and muted, 3 handed to ABOX's UAIF1, whose start and stop turn them on and off). Not on the command line by default.
CONFIG_HAKIOS_MAX98512=y
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# The speakers, the SoC's side: ABOX with its CPU off, RDMA0 -> UAIF1 (drivers/audio/hakios.exynos_abox.c), and the speakers'
# guard every sample goes through (hakios.guard.c). abox=N makes its first N steps (1 looks, 7 plays a tone, 8 serves iOS);
# not on the command line by default. The MAX98512 amplifiers are another driver's.
CONFIG_HAKIOS_GUARD=y
CONFIG_HAKIOS_EXYNOS_ABOX=y
# CONFIG_ABOX is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# CONFIG_HAKIOS_WIFI is not set
# Wi-Fi, stage 1 (drivers/wifi/hakios.exynos_pcie.c): PCIe channel 0 to the BCM4361, WLAN_REG_ON, the link, the chip's ID and BARs.
# Built in, started by wifi_pcie=N (1 only looks, 5 is all of stage 1, 6 hands the device on); not on the command line by
# default. No firmware.
# CONFIG_WIFI_PCIE is not set
CONFIG_HAKIOS_EXYNOS_PCIE=y
# Wi-Fi, stage 2 (drivers/wifi/hakios.brcmfmac.c, WIFI.md): Linux's brcmfmac on the BCM4361 (tools/mk-brcmfmac.sh makes its
# object; a kernel built without it says so), with the station layer above (WIFI_STA). Built in, started by
# wifi_pcie=6 brcmfmac=N (1 the chip's ID, 2 the files, 3 the firmware up, 4 its interface, 5 INTx, 6 the phone's address,
# 7 the station, 8 joining); not on the command line by default. Needs the firmware, NVRAM and CLM of the user's own phone
# in fw-wifi/ (and mac.info, network for 6 and 8).
# CONFIG_BRCMFMAC is not set
CONFIG_HAKIOS_BRCMFMAC=y
CONFIG_HAKIOS_WIFI_STA=y
# CONFIG_HAKIOS_BT is not set
# Bluetooth, stage 1 (drivers/bluetooth/hakios.bcm4361_bt.c, BLUETOOTH.md): the BCM4361's Bluetooth half on UART_BT, BT_EN on
# the PCAL6524 expander, HCI over H4 and Broadcom's patch. Built in, started by bt=N (1 only looks, 2 the expander, 3 the UART
# in loopback, 4 the chip powered, 5 HCI_Reset and its version, 6 the patch); not on the command line by default. Step 6 needs
# the phone's own bcm4361B2 .hcd in fw-bt/. No host stack.
# CONFIG_BT is not set
CONFIG_HAKIOS_BCM4361_BT=y
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# The USB port as a link to a host: the kernel's log streamed over a CDC-ACM serial port and a line console back
# (drivers/core/hakios.dwc3.c, device-neutral, and hakios.exynos_usb.c, the Exynos 9810's PHY and clocks). Built in, off
# until usb_gadget=N (1 looks, 2 the PHY, 3 the core, 4 enumerates, 5 streams the log). Not on the command line by default.
CONFIG_HAKIOS_USB_GADGET=y
CONFIG_HAKIOS_EXYNOS_USB=y
